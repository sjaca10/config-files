[user]
	email = TBD
	name = TBD
	signingkey = TBD
[core]
	editor = vim
	pager = delta
	excludesfile = TBD
[help]
	autocorrect = 1
[gpg]
 	format = ssh
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
